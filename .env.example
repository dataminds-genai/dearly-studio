# Copy to .env and fill in values. Never commit real keys.
# Supabase (public, VITE_ prefix is intentional)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""

# --- AI (server-only; must NOT use VITE_ prefix) ---
# Order used by /api/edit-artwork: Gemini → Pollinations → on-device canvas.
# Order used by /api/write-message: Gemini text models (fallback chain below).

# Gemini text generation (card messages: generate + correct/improve).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Text model for messages. Older models (2.5-flash, 1.5-flash) return 404 for new keys.
# Chain tried in order: GEMINI_TEXT_MODEL → gemini-3.5-flash-lite → gemini-3.1-flash-lite → gemini-flash-lite-latest
GEMINI_TEXT_MODEL="gemini-3.5-flash-lite"
# Gemini image editing (photo → art, identity-preserving).
# Chain tried in order: GEMINI_IMAGE_MODEL → gemini-3.1-flash-image → gemini-3-pro-image → gemini-2.5-flash-image
# Free-tier quota is small; 429 falls through to Pollinations, then on-device.
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# Cloudflare Workers AI (text fallback and photo-to-artwork image fallback).
# Free tier: 10k neurons/day. Dash → Workers AI: Account ID + API token
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_TOKEN=""
# Optional: override text model (default @cf/meta/llama-3.3-70b-instruct-fp8-fast)
CLOUDFLARE_TEXT_MODEL=""
# Image edit model for photo-to-art generation (FLUX.2 Klein 4B img2img)
CLOUDFLARE_IMAGE_MODEL="@cf/black-forest-labs/flux-2-klein-4b"

# Pollinations.ai (free photo → art fallback after Gemini).
# No key needed to try; free registration at https://auth.pollinations.ai
# raises limits (anon: 1 req/15s) and unlocks nologo + private images.
POLLINATIONS_API_KEY=""
# Optional: override img2img model (default kontext)
POLLINATIONS_IMAGE_MODEL="kontext"

# Unsplash live photo search (Occasion Photo Library, server-side proxy only).
# Free app at https://unsplash.com/oauth/applications (demo: 50 req/hr).
UNSPLASH_ACCESS_KEY=""

# Print handoff (Social Print Studio Order Handoff — redirect model).
# API key is optional (attribution/revenue split only); email is your
# contact for order issues. Docs: https://printkit.dev/docs/md/order-handoff
PRINTKIT_API_KEY=""
PRINTKIT_EMAIL=""

# --- Daily Image Generation Limits (24-hour cycle) ---
# Maximum generations per logged-in user in 24 hours (default: 10)
VITE_DAILY_IMAGE_LIMIT_LOGGED_IN="10"
DAILY_IMAGE_LIMIT_LOGGED_IN="10"

# Maximum generations for guest/anonymous user in 24 hours (default: 1)
VITE_DAILY_IMAGE_LIMIT_ANON="1"
DAILY_IMAGE_LIMIT_ANON="1"

# Warning threshold count to alert user about remaining generations (default: 5)
VITE_DAILY_IMAGE_WARNING_THRESHOLD="5"
DAILY_IMAGE_WARNING_THRESHOLD="5"

